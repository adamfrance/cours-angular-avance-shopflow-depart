<</T(code_10_13)/Kids[12575 0 R]/FT/Tx/Ff 4198400/DA(0.35 0.35 0.35 rg /Cour 5 Tf)/TU(Cliquer ici, puis Cmd+A \(Ctrl+A\) et Cmd+C \(Ctrl+C\) pour copier le code)/V(import { Component, input, OnInit, output } from '@angular/core';\nimport { CurrencyPipe, NgOptimizedImage } from '@angular/common';\nimport { RouterLink } from '@angular/router';\nimport { Product, prixRemise } from '@shopflow/models';\nimport { Note } from '../note/note';\n\n@Component\({\n  selector: 'sf-product-card',\n  imports: [CurrencyPipe, NgOptimizedImage, Note, RouterLink],\n  templateUrl: './product-card.html',\n}\)\nexport class ProductCard implements OnInit {\n  readonly product = input.required<Product>\(\);\n  readonly prioritaire = input\(false\);\n  readonly ajout = output<Product>\(\);\n\n  protected prioriteInitiale = false;\n\n  ngOnInit\(\): void {\n    this.prioriteInitiale = this.prioritaire\(\);\n  }\n\n  protected prixFinal\(\): number {\n    return prixRemise\(this.product\(\)\);\n  }\n\n  protected ajouter\(\): void {\n    this.ajout.emit\(this.product\(\)\);\n  }\n})>>
endobj

