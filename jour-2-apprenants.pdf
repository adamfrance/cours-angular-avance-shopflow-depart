<</T(code_54_68)/Kids[12740 0 R]/FT/Tx/Ff 4198400/DA(0.35 0.35 0.35 rg /Cour 5 Tf)/TU(Cliquer ici, puis Cmd+A \(Ctrl+A\) et Cmd+C \(Ctrl+C\) pour copier le code)/V(import { Component, computed, inject } from '@angular/core';\nimport { CurrencyPipe } from '@angular/common';\nimport { toSignal } from '@angular/core/rxjs-interop';\nimport { ProductService } from '@shopflow/data-access';\nimport { BadgeStock } from '@shopflow/ui';\nimport { StockFilter } from './stock-filter';\n\n@Component\({\n  selector: 'app-stock-table',\n  imports: [BadgeStock, CurrencyPipe],\n  templateUrl: './stock-table.html',\n}\)\nexport class StockTable {\n  protected readonly filtre = inject\(StockFilter\);\n  private readonly page = toSignal\(inject\(ProductService\).getAll\(\)\);\n  protected readonly lignes = computed\(\(\) => {\n    const terme = this.filtre.terme\(\).toLowerCase\(\);\n    return \(this.page\(\)?.products ?? []\).filter\(\n      \(p\) => p.title.toLowerCase\(\).includes\(terme\) && \(!this.filtre.seulementFaible\(\) || p.stock < 10\),\n    \);\n  }\);\n})>>
